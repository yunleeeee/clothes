# Copy to .env.local (never commit that file)
# Must be an OpenAI-compatible CHAT COMPLETIONS base URL, e.g. https://school.example.edu/v1
DEEPSEEK_BASE_URL=https://YOUR-SCHOOL-API/v1
DEEPSEEK_API_KEY=YOUR_PRIVATE_KEY
# Must support visual image input for AI garment recognition
DEEPSEEK_MODEL=YOUR_VISION_MODEL_ID
PORT=3000
